<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Aspirateur Balai sans Fil</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 0;
            background-color: #f5f5f5;
            color: #333;
        }

        .container {
            display: flex;
            max-width: 1200px;
            margin: 20px auto;
            background-color: #fff;
            box-shadow: 0 0 5px rgba(0, 0, 0, 0.1);
            border-radius: 8px;
        }

        .image-section {
            flex: 1;
        }

        .image-section img {
            width: 100%;
            border-top-left-radius: 8px;
            border-bottom-left-radius: 8px;
        }

        .details-section {
            flex: 1;
            padding: 20px;
        }

        .price {
            font-size: 24px;
            color: red;
            font-weight: bold;
        }

        .old-price {
            text-decoration: line-through;
            color: #888;
            font-size: 18px;
        }

        .product-title {
            font-size: 22px;
            margin-bottom: 10px;
        }

        .features {
            margin: 10px 0;
        }

        .features li {
            margin: 5px 0;
        }

        .add-to-cart {
            background-color: #3d5afe;
            color: #fff;
            padding: 10px 20px;
            text-decoration: none;
            border-radius: 5px;
            display: inline-block;
            margin-top: 20px;
        }

        .delivery-info {
            margin-top: 30px;
        }

        .delivery-info p {
            margin: 5px 0;
        }

        .footer {
            display: flex;
            justify-content: space-around;
            padding: 15px;
            border-top: 1px solid #ddd;
            margin-top: 20px;
        }

        .footer div {
            text-align: center;
        }

        .footer a {
            text-decoration: none;
            color: #3d5afe;
        }
    </style>
</head>
<body>
    <div class="container">
    
        <div class="image-section">
            <img src="image.png" alt="Aspirateur Balai sans Fil">
        </div>
        
        <div class="details-section">
            <h1 class="product-title">Aspirateur Balai sans Fil 58000Pa</h1>
            <p>Multifonctions 8 en 1 - 600W - Batterie Amovible</p>
            <p class="old-price">319,99 €</p>
            <p class="price">129,99 €</p>
            
            <ul class="features">
                <li>Mode de nettoyage : mode de base - mode renforcé</li>
                <li>Force d'aspiration : 58000 Pa</li>
                <li>Capacité du collecteur : 1,8L</li>
                <li>Niveau sonore maximal : 58dB</li>
            </ul>

            <a href="#" class="add-to-cart">Ajouter au panier</a>

            
            <div class="delivery-info">
                <h3>Informations de livraison</h3>
                <p>Livraison gratuite en France métropolitaine</p>
                <p>Livré chez vous entre le <strong>24/12</strong> et le <strong>30/12</strong></p>
                <p>Retour possible sous 30 jours</p>
            </div>
        </div>
    </div>

    
    <div class="footer">
        <div>
            <h4>Livraison gratuite</h4>
            <p>En France métropolitaine</p>
        </div>
        <div>
            <h4>Garantie légale</h4>
            <p>2 ans inclus</p>
        </div>
        <div>
            <h4>Reprise gratuite</h4>
            <p>Reprise de votre ancien produit</p>
        </div>
        <div>
            <h4>Paiement flexible</h4>
            <a href="#">Payez en 3 à 20 fois</a>
        </div>
    </div>
</body>
</html>
